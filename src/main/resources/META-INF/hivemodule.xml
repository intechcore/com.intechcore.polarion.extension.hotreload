<?xml version="1.0" encoding="UTF-8"?>
<module id="com.intechcore.polarion.extension.hotreload" version="1.0.0">

    <!-- The administration-menu entries. Every page of the React app gets one extender here, and its
         `feature` query parameter MUST match an id in ui/src/features.tsx - a typo is a blank page in
         Polarion and no test catches it. `embedded=true` tells the app it is inside Polarion's iframe;
         `$scope$` is substituted by Polarion. The entries exist in the global scope only.

         The REST API entry is not a page: it opens the generated Swagger UI in the REST webapp. -->
    <contribution configuration-id="com.polarion.xray.webui.administrationPageExtenders">
        <extender id="rescan"
                  name="Rescan Extensions"
                  parentNodeId="hotreload"
                  parentNodeName="Hot Reload"
                  parentNodeIconUrl="/polarion/hotreload-app/ui/images/menu/30x30/_parent.svg"
                  iconUrl="/polarion/hotreload-app/ui/images/menu/16x16/rescan.svg"
                  pageUrl="/polarion/hotreload-app/ui/app/index.html?feature=rescan&amp;embedded=true&amp;scope=$scope$"
                  projectScope="false"
                  projectGroupScope="false"
                  repositoryScope="true"/>

        <extender id="about"
                  name="About"
                  parentNodeId="hotreload"
                  iconUrl="/polarion/hotreload-app/ui/images/menu/16x16/about.svg"
                  pageUrl="/polarion/hotreload-app/ui/app/index.html?feature=about&amp;embedded=true&amp;scope=$scope$"
                  projectScope="false"
                  projectGroupScope="false"
                  repositoryScope="true"/>

        <extender id="disclaimer"
                  name="Disclaimer"
                  parentNodeId="hotreload"
                  iconUrl="/polarion/hotreload-app/ui/images/menu/16x16/disclaimer.svg"
                  pageUrl="/polarion/hotreload-app/ui/app/index.html?feature=disclaimer&amp;embedded=true&amp;scope=$scope$"
                  projectScope="false"
                  projectGroupScope="false"
                  repositoryScope="true"/>

        <extender id="rest-api"
                  name="REST API"
                  parentNodeId="hotreload"
                  iconUrl="/polarion/hotreload-app/ui/images/menu/16x16/rest_api.svg"
                  pageUrl="/polarion/hotreload/rest/swagger"
                  projectScope="false"
                  projectGroupScope="false"
                  repositoryScope="true"/>

    </contribution>

</module>
